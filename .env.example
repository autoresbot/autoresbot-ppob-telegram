# Salin file ini menjadi .env lalu isi.
# Bot tetap berjalan bila konfigurasi belum lengkap, tetapi fitur terkait dinonaktifkan
# dan admin mendapat info "konfigurasi belum selesai". Cek kapan saja dengan /config.

# [WAJIB] Token bot dari @BotFather — tanpa ini bot tidak bisa berjalan
BOT_TOKEN=

# [WAJIB untuk transaksi] API key Autoresbot (Dashboard > Akun > API Key). JANGAN dibagikan.
AUTORESBOT_APIKEY=

# [WAJIB untuk deposit] ID Telegram admin, pisahkan dengan koma (cek ID di @userinfobot)
ADMIN_IDS=

# [WAJIB untuk deposit] Minimal salah satu: teks rekening ATAU gambar QRIS (boleh keduanya).
# Teks rekening / e-wallet. Pakai \n untuk baris baru. Bisa juga diatur dari Telegram: /setpayment
# Contoh: DEPOSIT_INFO=Transfer ke:\nBCA 1234567890 a.n. Toko Saya\nDANA 081234567890 a.n. Toko Saya
DEPOSIT_INFO=
# Lokasi gambar QRIS (JPG/PNG). Ganti file ini, atau kirim lewat Telegram: /setqris
# Contoh tampilan ada di assets/qris-contoh.jpg (BUKAN untuk dipakai pembayaran)
QRIS_PATH=./assets/qris.jpg

# Nama toko yang tampil di bot
STORE_NAME=PPOB Store

# Keuntungan: harga jual = harga modal + (harga modal x MARKUP_PERCENT%) + MARKUP_FLAT
# Bisa diubah saat bot berjalan lewat perintah admin /markup
MARKUP_FLAT=500
MARKUP_PERCENT=0
# Pembulatan harga jual ke atas (kelipatan)
ROUND_TO=50

# Batas nominal deposit
MIN_DEPOSIT=10000
MAX_DEPOSIT=5000000

# Deposit yang tidak dikirim bukti transfernya otomatis kedaluwarsa setelah sekian jam (0 = tidak pernah).
# Bila pelanggan mengirim bukti setelahnya (≤ 7 hari), deposit dibuka kembali untuk admin.
DEPOSIT_EXPIRE_HOURS=24
# Maksimal deposit "menunggu" per pelanggan (anti-spam)
MAX_PENDING_DEPOSIT=3

# Lokasi database SQLite
DB_PATH=./data/bot.db

# Backup database otomatis sekali sehari (jam WIB). BACKUP_KEEP = jumlah file disimpan, 0 = nonaktif.
BACKUP_DIR=./data/backup
BACKUP_KEEP=7
